{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "aptitude_up", "refId": "A" }],
      "title": "Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "aptitude_uptime_seconds", "refId": "A" }],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "rate(aptitude_http_requests_total[1m])", "refId": "A" }],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(aptitude_http_errors_total[1m]) / clamp_min(rate(aptitude_http_requests_total[1m]), 0.001)",
          "refId": "A"
        }
      ],
      "title": "Error rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(aptitude_http_request_duration_seconds_sum[1m]) / clamp_min(rate(aptitude_http_request_duration_seconds_count[1m]), 0.001)",
          "legendFormat": "average latency",
          "refId": "A"
        }
      ],
      "title": "Latency",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["aptitude"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Foundation assessment",
  "uid": "aptitude-foundation",
  "version": 1
}
